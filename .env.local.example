# =============================================================
# 屋台注文管理アプリ  環境変数
# このファイルを .env.local にコピーして値を書き換えてください。
# .env.local は git に入りません(.gitignore 済み)。
# =============================================================

# --- データベース(自前サーバーの PostgreSQL) ---
# 形式: postgresql://ユーザー名:パスワード@ホスト:ポート/DB名
#   同じPC上で動かす場合         : localhost
#   別PCのサーバーに繋ぐ場合     : そのPCのIP(例: 192.168.1.20)
#   パスワードに記号(@ : / など)を含む場合は URL エンコードしてください
DATABASE_URL=postgresql://stall:change-me@localhost:5432/stall_orders

# SSL の使い方 (省略時は disable)
#   disable   … LAN 内の自前サーバーはこれでOK
#   require   … SSL を使い、証明書も検証する
#   no-verify … SSL を使うが証明書は検証しない(自己署名証明書のとき)
# DATABASE_SSL=disable

# 同時接続数の上限 (省略時は 10)
# DATABASE_POOL_MAX=10

# --- 管理者ログイン(絶対にブラウザに出さない / NEXT_PUBLIC を付けない) ---
# 管理者ログインのパスワード(自分で好きな文字列を決める)
ADMIN_PASSWORD=change-me-to-a-strong-password

# セッション署名用のランダム文字列
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret

# --- 本番サーバー(start-server.cmd / npm run serve) ---
# 待ち受けるポート (省略時は 3000)
# PORT=3000
# 起動時に git から更新を取り込まない場合は 0
# AUTO_PULL=0

# =============================================================
# セットアップ手順
#   1. PostgreSQL にデータベースとユーザーを作る
#        createdb stall_orders
#        (psql から) create user stall with password 'xxx';
#                    grant all on database stall_orders to stall;
#   2. 上の DATABASE_URL を実際の値に書き換える
#   3. 開発: npm install → npm run db:setup → npm run dev
#   4. 本番: start-server.cmd をダブルクリック (または npm run serve)
#        更新の取り込み・インストール・ビルド・DB 準備を必要なときだけ自動で行って起動します
# =============================================================
